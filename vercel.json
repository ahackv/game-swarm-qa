{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true,
      "excludeFiles": "{.env,.env.*,private/**,evidence/**,research/**,dist/**,assets/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:engine/:action", "destination": "/api/index?endpoint=:engine/:action" },
    { "source": "/football-legends", "destination": "/game.html" },
    { "source": "/ovo", "destination": "/game.html" },
    { "source": "/football-legends/explore", "destination": "/explore.html" },
    { "source": "/ovo/explore", "destination": "/explore.html" },
    { "source": "/football-legends/findings/goal-camping", "destination": "/player.html" },
    { "source": "/ovo/findings/left-wall-shortcut", "destination": "/player.html" },
    { "source": "/ovo/findings/credits-unlock", "destination": "/player.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; frame-ancestors 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
